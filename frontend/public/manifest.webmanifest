{
  "name": "MIRAGE",
  "short_name": "MIRAGE",
  "description": "Check a suspicious voice note, image, video or message for deepfake-enabled scams and get the next step.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#04060b",
  "theme_color": "#05070d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["audio/*", "image/*", "video/*", ".ogg", ".opus", ".m4a", ".aac", ".amr"] }
      ]
    }
  }
}
